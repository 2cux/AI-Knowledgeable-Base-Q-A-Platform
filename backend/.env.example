# Copy this file to .env for local development.
# Keep real secrets out of Git.

# Required: Spring profile
SPRING_PROFILES_ACTIVE=dev

# Required: MySQL
# application-dev.yml can build DB_URL from DB_HOST / DB_PORT / DB_NAME.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aikb
DB_URL=jdbc:mysql://localhost:3306/aikb?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Required: RabbitMQ for document process / embedding async tasks
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# Required: JWT / login security
JWT_SECRET=please_change_this_secret_at_least_32_chars
JWT_EXPIRATION=86400000
JWT_ISSUER=aikb-backend

# Required: LLM
APP_LLM_BASE_URL=https://api.example.com/v1/messages
APP_LLM_API_KEY=your_llm_api_key
APP_LLM_MODEL=your_chat_model

# Required: Embedding
APP_EMBEDDING_BASE_URL=https://api.example.com/v1/embeddings
APP_EMBEDDING_API_KEY=your_embedding_api_key
APP_EMBEDDING_MODEL=text-embedding-3-large
APP_EMBEDDING_VECTOR_SIZE=3072

# Optional: shared fallback API key when LLM and Embedding use the same provider.
OPENAI_API_KEY=
OPENAI_LLM_BASE_URL=
OPENAI_EMBEDDING_BASE_URL=

# Optional: Redis cache for admin stats / hot questions.
# If Redis is unavailable, related admin cache reads can fall back to MySQL.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms
ADMIN_STATS_CACHE_TTL_MINUTES=5
HOT_QUESTIONS_CACHE_TTL_MINUTES=5

# Optional: file upload and multipart limits
APP_FILE_UPLOAD_DIR=uploads
APP_FILE_MAX_SIZE=20MB

# Optional: debug API and CORS
APP_DEBUG_API_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: RAG retrieval
APP_RAG_RETRIEVAL_TOP_K=5
APP_RAG_RETRIEVAL_MIN_EFFECTIVE_SCORE=0.2
