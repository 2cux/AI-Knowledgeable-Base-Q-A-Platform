# Spring profile
SPRING_PROFILES_ACTIVE=dev

# MySQL
DB_URL=jdbc:mysql://localhost:3306/aikb?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms
ADMIN_STATS_CACHE_TTL_MINUTES=5

# JWT
# Local examples only. Production must use a long random secret from environment variables.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000
JWT_ISSUER=aikb-backend

# LLM
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://api.xiaocaseai.com/v1/messages
APP_LLM_MODEL=claude-opus-4-6

# Embedding
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_BASE_URL=https://api.xiaocaseai.com/v1/embeddings
APP_EMBEDDING_MODEL=text-embedding-3-large

# Optional fallback when LLM and Embedding share the same provider key.
OPENAI_API_KEY=

# Uploads and RAG retrieval
APP_FILE_UPLOAD_DIR=uploads
APP_RAG_RETRIEVAL_TOP_K=5
APP_RAG_RETRIEVAL_MIN_EFFECTIVE_SCORE=0.2
