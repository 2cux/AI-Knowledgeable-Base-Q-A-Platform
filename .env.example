# ============================================
# AI Knowledge Base QA Platform
# Environment Variables
# ============================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env
# ============================================

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=dev

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_kb_platform
DB_USERNAME=root
DB_PASSWORD=123456

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# ---- JWT ----
JWT_SECRET=please-change-this-secret-at-least-32-chars
JWT_EXPIRATION=86400000
JWT_ISSUER=aikb-backend

# ---- LLM (required) ----
APP_LLM_ENABLED=true
APP_LLM_BASE_URL=https://api.example.com/v1/messages
APP_LLM_API_KEY=your_llm_api_key_here
APP_LLM_MODEL=your-chat-model
APP_LLM_MAX_TOKENS=1024

# ---- Embedding (required) ----
APP_EMBEDDING_ENABLED=true
APP_EMBEDDING_BASE_URL=https://api.example.com/v1/embeddings
APP_EMBEDDING_API_KEY=your_embedding_api_key_here
APP_EMBEDDING_MODEL=text-embedding-3-large
APP_EMBEDDING_VECTOR_SIZE=3072

# ---- Frontend ----
# Vite only reads .env files from the frontend/ directory.
# Copy this variable to frontend/.env if you need a custom value;
# otherwise frontend/.env.development provides the default.
VITE_API_BASE_URL=http://localhost:8080

# ---- CORS ----
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- RAG ----
APP_RAG_RETRIEVAL_TOP_K=5
APP_RAG_RETRIEVAL_MIN_EFFECTIVE_SCORE=0.2

# ---- File Upload ----
APP_FILE_UPLOAD_DIR=uploads
APP_FILE_MAX_SIZE=20MB

# ---- Cache ----
ADMIN_STATS_CACHE_TTL_MINUTES=5
HOT_QUESTIONS_CACHE_TTL_MINUTES=5

# ---- Debug ----
APP_DEBUG_API_ENABLED=false
